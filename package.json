{
    "name": "dlunire-dark",
    "displayName": "DLUnire Dark",
    "description": "A high-contrast Visual Studio Code theme featuring an ultra-dark background and vibrant semantic syntax highlighting.",
    "version": "1.0.1",
    "publisher": "dlunire",
    "license": "MIT",
    "icon": "icon.png",

    "repository": {
        "type": "git",
        "url": "https://github.com/dlunire/theme-dlunire-dark"
    },

    "homepage": "https://dlunire.dev",

    "bugs": {
        "url": "https://github.com/dlunire/theme-dlunire-dark/issues"
    },

    "engines": {
        "vscode": "^1.80.0"
    },

    "categories": [
        "Themes"
    ],

    "keywords": [
        "theme",
        "dark",
        "high-contrast",
        "black",
        "color-theme",
        "php",
        "typescript",
        "javascript",
        "html",
        "css",
        "scss",
        "semantic",
        "syntax-highlighting",
        "dlunire"
    ],

    "galleryBanner": {
        "color": "#010305",
        "theme": "dark"
    },

    "pricing": "Free",

    "files": [
        "themes/dlunire-dark-color-theme.json",
        "README.md",
        "LICENSE",
        "icon.png",
        "dlunire-dark.webp",
        "dlunire-dark-type.webp"
    ],

    "contributes": {
        "themes": [
            {
                "label": "DLUnire Dark",
                "uiTheme": "vs-dark",
                "path": "themes/dlunire-dark-color-theme.json"
            }
        ]
    },

    "scripts": {
        "package": "vsce package --no-git-tag-version",
        "publish:vscode": "vsce publish",
        "publish:openvsx": "ovsx publish"
    },

    "devDependencies": {
        "@vscode/vsce": "^3.9.2",
        "ovsx": "^1.1.0"
    }
}